# OpenAI-compatible Chat Completions API base, not a project endpoint or operation URL.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-id
OPENAI_AUTH_MODE=api_key
OPENAI_API_KEY=

# For an Azure model that requires Entra authentication:
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
# OPENAI_MODEL=your-deployment-name
# OPENAI_AUTH_MODE=entra
# Run az login locally. OPENAI_API_KEY is not used in Entra mode.

# Only required by the WebIQ MCP demos.
WEBIQ_API_KEY=
